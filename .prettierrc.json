{
  "semi": false,
  "singleQuote": true,
  "tabWidth": 4,
  "printWidth": 110,
  "trailingComma": "all",
  "bracketSameLine": false,
  "overrides": [
    {
      "files": ["*.json", "*.yml", "*.yaml"],
      "options": { "tabWidth": 2 }
    },
    {
      "files": ["*.md"],
      "options": { "proseWrap": "preserve", "tabWidth": 2 }
    }
  ]
}
