# Environment for the Playwright suite. Uses its own SQLite file so a test run
# cannot disturb the development database, and enables the admin bypass — which
# is honoured only because APP_ENV is one of the development environments
# listed in config/ribs.php. The Cloudflare Access path itself is covered by
# the PHP feature tests, which use real signed tokens.
#
# This file is loaded because Playwright starts the server with APP_ENV=e2e and
# Laravel reads .env.<APP_ENV>. The name has to stay "e2e" for both halves of
# that to line up.
APP_NAME="Ribs Recipes"
APP_ENV=e2e
APP_DEBUG=false
APP_URL=http://127.0.0.1:8321
# Left blank here on purpose. tests/e2e/global-setup.ts copies this file to
# .env.e2e (which is git-ignored) and generates a key into that copy, so a
# generated key can never end up in a commit.
APP_KEY=

DB_CONNECTION=sqlite
DB_DATABASE=database/e2e.sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
LOG_LEVEL=warning

ADMIN_DEV_BYPASS=true
ADMIN_DEV_EMAIL=owner@example.test
ADMIN_EMAIL=owner@example.test
ADMIN_NAME="Test Owner"

IMPORT_ALLOW_PRIVATE_NETWORKS=false
