# Environment for the Playwright suite. Uses its own SQLite file so a test run
# can never disturb the development database, and enables the admin bypass —
# which is honoured only because APP_ENV is local. The Cloudflare Access path
# itself is covered by the PHP feature tests, which use real signed tokens.
APP_NAME="Ribs Recipes"
APP_ENV=local
APP_DEBUG=false
APP_URL=http://127.0.0.1:8321
# Left blank here on purpose. tests/e2e/global-setup.ts copies this file to
# .env.e2e (which is git-ignored) and generates a key into that copy, so a
# generated key can never end up in a commit.
APP_KEY=

DB_CONNECTION=sqlite
DB_DATABASE=database/e2e.sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
LOG_LEVEL=warning

ADMIN_DEV_BYPASS=true
ADMIN_DEV_EMAIL=owner@example.test
ADMIN_EMAIL=owner@example.test
ADMIN_NAME="Test Owner"

IMPORT_ALLOW_PRIVATE_NETWORKS=false
