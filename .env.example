###############################################################################
# Ribs Recipes — environment configuration
#
# Copy to `.env` and fill in. NEVER commit a real .env file.
###############################################################################

APP_NAME="Ribs Recipes"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://recipes.ribarichh.com
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- Logging -----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# --- Database ----------------------------------------------------------------
# SQLite lives on a persistent Docker volume in production.
DB_CONNECTION=sqlite
# DB_DATABASE=/var/www/html/storage/database/database.sqlite

# --- Drivers -----------------------------------------------------------------
# No Redis. File-based cache/session keeps SQLite write contention low.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Docker / Traefik --------------------------------------------------------
# The image to run. Set this to your published tag to deploy with
# `docker compose pull && docker compose up -d` instead of building on the
# server. Leave it unset to build from the checkout.
# RIBS_IMAGE=yourdockerhubuser/ribs-recipes:latest

# The hostname Traefik routes to this container.
APP_HOST=recipes.ribarichh.com

# The name of the EXISTING Traefik network on the server. Find it with:
#   docker network ls
# It is commonly "traefik", "proxy" or "web".
TRAEFIK_NETWORK=traefik

# Which Traefik entrypoint to attach to. With a Cloudflare Tunnel terminating
# HTTPS and talking plain HTTP to Traefik, this is your HTTP entrypoint.
TRAEFIK_ENTRYPOINT=web

# Set both of these only if Traefik itself holds the certificate rather than
# Cloudflare (then use your websecure entrypoint above).
TRAEFIK_TLS=false
TRAEFIK_CERT_RESOLVER=

# --- Proxies -----------------------------------------------------------------
# The container is only reachable through Traefik, so trusting the proxy is
# required for correct https:// URL generation and client IP detection.
TRUSTED_PROXIES=*

# --- Cloudflare Zero Trust Access (admin authentication) ----------------------
# Team domain, e.g. "ribarichh.cloudflareaccess.com" (no scheme).
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) tag from the Access application's Overview page.
CLOUDFLARE_ACCESS_AUD=
# Seconds to cache Cloudflare's public JWKS.
CLOUDFLARE_ACCESS_JWKS_TTL=3600
# Allow a small clock skew (seconds) when validating exp/iat/nbf.
CLOUDFLARE_ACCESS_LEEWAY=30

# --- Admin identity ----------------------------------------------------------
# The email that is provisioned as the "owner" user by the seeder, and that
# maps to the owner account when it authenticates through Cloudflare Access.
ADMIN_EMAIL=you@example.com
ADMIN_NAME="Justin Ribarich"
# When true, a verified Cloudflare identity with no matching users row is
# auto-provisioned as a "contributor". Leave false for a single-user install.
ADMIN_AUTO_PROVISION=false

# --- LOCAL DEVELOPMENT ONLY --------------------------------------------------
# Bypasses Cloudflare Access for /admin. This is IGNORED unless APP_ENV is one
# of local/development/testing — production can never fall back to open admin.
ADMIN_DEV_BYPASS=false
ADMIN_DEV_EMAIL=you@example.com

# --- Images ------------------------------------------------------------------
# Max upload size in kilobytes.
IMAGE_MAX_UPLOAD_KB=25600
# Longest edge (px) the stored "full" image is resized down to.
IMAGE_MAX_EDGE=2400
# Encoder quality (1-100) for generated WebP/JPEG variants.
IMAGE_QUALITY=82
# gd or imagick. imagick handles HEIC/AVIF if compiled with support.
IMAGE_DRIVER=gd

# --- Recipe URL importer -----------------------------------------------------
IMPORT_FETCH_TIMEOUT=12
IMPORT_FETCH_MAX_BYTES=3145728
IMPORT_FETCH_MAX_REDIRECTS=3
# Allow fetching private/loopback addresses. DANGEROUS — dev only.
IMPORT_ALLOW_PRIVATE_NETWORKS=false

# --- CSV importer ------------------------------------------------------------
CSV_IMPORT_MAX_ROWS=250

VITE_APP_NAME="${APP_NAME}"
